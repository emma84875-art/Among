rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net: Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Hardened Global Helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // User Profile Validation Helper
    function isValidUser(data) {
      return data.id is string && data.id.size() <= 128
        && data.phoneNumber is string && data.phoneNumber.size() <= 20
        && data.displayName is string && data.displayName.size() >= 2 && data.displayName.size() <= 40
        && data.username is string && data.username.size() >= 3 && data.username.size() <= 20
        && data.presence in ['here', 'focus', 'quiet', 'offline', 'walking'];
    }

    // User collection rules
    match /users/{userId} {
      allow get: if isSignedIn() && isValidId(userId);
      allow list: if isSignedIn();
      allow create: if isOwner(userId)
        && isValidId(userId)
        && isValidUser(incoming())
        && incoming().id == userId;
      allow update: if isOwner(userId)
        && isValidId(userId)
        && isValidUser(incoming())
        && incoming().id == existing().id;
      allow delete: if isOwner(userId) && isValidId(userId);
    }

    // Connections collection rules
    match /connections/{connectionId} {
      allow get: if isSignedIn() && isValidId(connectionId)
        && (existing().user1Id == request.auth.uid || existing().user2Id == request.auth.uid);
      allow list: if isSignedIn()
        && (resource.data.user1Id == request.auth.uid || resource.data.user2Id == request.auth.uid);
      allow create: if isSignedIn() && isValidId(connectionId)
        && (incoming().user1Id == request.auth.uid || incoming().user2Id == request.auth.uid);
      allow update: if isSignedIn() && isValidId(connectionId)
        && (existing().user1Id == request.auth.uid || existing().user2Id == request.auth.uid);
      allow delete: if isSignedIn() && isValidId(connectionId)
        && (existing().user1Id == request.auth.uid || existing().user2Id == request.auth.uid);
    }

    // Connection Requests collection rules
    match /connectionRequests/{requestId} {
      allow get: if isSignedIn() && isValidId(requestId)
        && (existing().senderId == request.auth.uid || existing().receiverId == request.auth.uid);
      allow list: if isSignedIn()
        && (resource.data.senderId == request.auth.uid || resource.data.receiverId == request.auth.uid);
      allow create: if isSignedIn() && isValidId(requestId)
        && incoming().senderId == request.auth.uid
        && incoming().status == 'pending';
      allow update: if isSignedIn() && isValidId(requestId)
        && (existing().senderId == request.auth.uid || existing().receiverId == request.auth.uid);
      allow delete: if isSignedIn() && isValidId(requestId)
        && (existing().senderId == request.auth.uid || existing().receiverId == request.auth.uid);
    }

    // Chats collection rules
    match /chats/{chatId} {
      allow get: if isSignedIn() && isValidId(chatId)
        && request.auth.uid in existing().participants;
      allow list: if isSignedIn()
        && request.auth.uid in resource.data.participants;
      allow create: if isSignedIn() && isValidId(chatId)
        && request.auth.uid in incoming().participants;
      allow update: if isSignedIn() && isValidId(chatId)
        && request.auth.uid in existing().participants;
      allow delete: if isSignedIn() && isValidId(chatId)
        && request.auth.uid in existing().participants;

      // Messages subcollection
      match /messages/{messageId} {
        allow get: if isSignedIn() && isValidId(messageId);
        allow list: if isSignedIn();
        allow create: if isSignedIn() && isValidId(messageId)
          && incoming().senderId == request.auth.uid
          && incoming().chatId == chatId
          && incoming().text is string && incoming().text.size() > 0 && incoming().text.size() <= 2000;
        allow update: if isSignedIn() && isValidId(messageId);
        allow delete: if isSignedIn() && isValidId(messageId);

        // Reactions subcollection
        match /reactions/{reactionId} {
          allow get: if isSignedIn() && isValidId(reactionId);
          allow list: if isSignedIn();
          allow create, update: if isSignedIn() && isValidId(reactionId)
            && incoming().userId == request.auth.uid
            && incoming().chatId == chatId
            && incoming().messageId == messageId
            && incoming().emoji is string && incoming().emoji.size() <= 32;
          allow delete: if isSignedIn() && isValidId(reactionId)
            && existing().userId == request.auth.uid;
        }
      }
    }
  }
}
